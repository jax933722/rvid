# Business Intelligence Search Engine — example environment configuration.
# Copy to `.env` for local development. NEVER commit a real `.env` or secrets.
# All values are read ONLY through config/settings.py (no scattered os.getenv).
# Every variable is prefixed BISE_ (pydantic-settings env_prefix).

# --- Application ---
BISE_ENV=local                       # local | test | prod
BISE_DEBUG=true

# --- Database (SQLite dev / PostgreSQL prod behind one URL) ---
# Dev default (no server needed):
BISE_DATABASE_URL=sqlite:///./bise.db
# Production example (uncomment and inject the real password at runtime):
# BISE_DATABASE_URL=postgresql+psycopg://bise:change-me@localhost:5432/bise
BISE_DB_ECHO=false

# --- Search backend (the FTS -> OpenSearch swap seam, doc 5) ---
BISE_SEARCH_BACKEND=postgres_fts     # postgres_fts | opensearch

# --- Logging ---
BISE_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
BISE_LOG_JSON=true

# --- Future modules (not yet read by settings; documented for planning) ---
# BISE_REDIS_URL=redis://localhost:6379/0
# BISE_CRAWL_USER_AGENT=BISEbot/0.1 (+https://example.local/bot)
# BISE_CRAWL_MAX_CONCURRENCY_PER_HOST=2
# BISE_CRAWL_DEFAULT_DELAY_SECONDS=1.0
