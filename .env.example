# Business Intelligence Search Engine — example environment configuration.
# Copy to `.env` for local development. NEVER commit a real `.env` or secrets.
# All values are read ONLY through config/settings.py (no scattered os.getenv).

# --- Application ---
BISE_ENV=local                       # local | test | prod
BISE_DEBUG=true

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bise
DB_USER=bise
DB_PASSWORD=change-me                # placeholder only; inject the real one at runtime

# --- Redis (queue + cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Search backend selection (the FTS -> OpenSearch swap seam, doc 5) ---
SEARCH_BACKEND=postgres_fts          # postgres_fts | opensearch
# OPENSEARCH_URL=http://localhost:9200

# --- Crawling politeness (doc 6) ---
CRAWL_USER_AGENT=BISEbot/0.1 (+https://example.local/bot)
CRAWL_MAX_CONCURRENCY_PER_HOST=2
CRAWL_DEFAULT_DELAY_SECONDS=1.0
CRAWL_REQUEST_TIMEOUT_SECONDS=15
CRAWL_MAX_PAGES_PER_SITE=50

# --- Logging (doc 9) ---
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true

# --- Ranking (doc 5) — tunable without a deploy ---
RANK_TEXT_WEIGHT=0.7
RANK_SCORE_WEIGHT=0.3
